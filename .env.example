# DeepRadio 配置示例（复制为 .env 后填写真实值）

# 必填：OpenAI 兼容接口的根地址
GRC_AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 必填：接口密钥
GRC_AGENT_API_KEY=your-api-key-here

# 必填：模型名称
GRC_AGENT_MODEL=glm-5.3

# 可选：单次请求超时秒数，默认 120
GRC_AGENT_TIMEOUT=120

# 可选：disabled、enabled、auto、low、high 或 max，默认 disabled
GRC_AGENT_THINKING=low

# 可选：单轮 Agent 最大递归步数，默认 150
GRC_AGENT_RECURSION_LIMIT=150

# 可选：终端运行日志，1 开启，0 关闭，默认开启
GRC_AGENT_TRACE=1

# 可选：指定能够导入 GNU Radio 的 Python，仅在硬件运行环境不一致时设置
# GRC_AGENT_PYTHON=C:\path\to\python.exe
