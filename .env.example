# GRC Agent LLM 配置示例 (复制为 .env 并填入真实值)
# 配置全部通过环境变量注入, 不写死任何 key。

# 接口根地址, 实际请求 {BASE_URL}/chat/completions
GRC_AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 鉴权 key, 作为 Authorization: Bearer <key>
GRC_AGENT_API_KEY=your-api-key-here

# 模型名, 如 glm-4.6 / glm-5.2
GRC_AGENT_MODEL=glm-5.2

# 以下两项可选, 不填则使用默认值
# 单次请求超时秒数 (默认 120)
GRC_AGENT_TIMEOUT=120
# 送入模型的历史消息条数上限 (默认 20)
GRC_AGENT_MAX_MESSAGES=20
